# AI Finance Controller — Root Environment Configuration Example

# AI Provider Configuration (Optional — Fallbacks to Heuristic AI Engine if blank)
AI_PROVIDER=google
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# Backend Host Configuration
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-vercel-app.vercel.app

# Frontend API Configuration
VITE_API_BASE_URL=http://localhost:8000
